{
  "name": "nepali-calendar-monorepo",
  "version": "1.0.0",
  "description": "Nepali Calendar (Bikram Sambat) monorepo with core library and web app",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter nepali-calendar-web dev",
