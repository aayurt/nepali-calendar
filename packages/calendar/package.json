{
  "name": "@8848/nepali-calendar",
  "version": "0.1.0",
  "description": "Nepali calendar (Bikram Sambat) with date conversion, holidays, and festivals",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "lint": "eslint src --ext ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "nepali-calendar",
    "bikram-sambat",
    "bs-calendar",
    "date-conversion",
    "nepali-holidays",
    "nepali-festivals",
    "vikram-samvat"
  ],
  "author": "Aayur Shrestha",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/aayurt/nepali-calendar.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "tsup": "^8.2.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}